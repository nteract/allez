{
  "add_anaconda_token": true,
  "allowlist_channels": [
    "conda-forge"
  ],
  "always_copy": true,
  "always_softlink": false,
  "always_yes": true,
  "auto_activate": true,
  "auto_update_conda": true,
  "channels": [
    "conda-forge"
  ],
  "client_ssl_cert": "/tmp/cert.pem",
  "client_ssl_cert_key": "/tmp/cert-key.pem",
  "disallowed_packages": [
    "numpy"
  ],
  "environment_specifier": null,
  "envs_dirs": [
    "/tmp/envs"
  ],
  "export_platforms": [
    "linux-64"
  ],
  "override_virtual_packages": {
    "cuda": "11.0"
  },
  "prefix_data_interoperability": true,
  "root_prefix": "/opt/conda",
  "solver": "libmamba",
  "ssl_verify": true,
  "verbosity": 1
}
