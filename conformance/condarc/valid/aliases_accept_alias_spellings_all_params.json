{
  "channel": [
    "conda-forge"
  ],
  "whitelist_channels": [
    "conda-forge"
  ],
  "add_binstar_token": true,
  "envs_path": [
    "/tmp/envs"
  ],
  "client_cert": "/tmp/cert.pem",
  "client_cert_key": "/tmp/cert-key.pem",
  "verify_ssl": true,
  "self_update": true,
  "disallow": [
    "numpy"
  ],
  "pip_interop_enabled": true,
  "experimental_solver": "libmamba",
  "copy": true,
  "softlink": false,
  "yes": true,
  "auto_activate": true,
  "verbose": 1,
  "extra_platforms": [
    "linux-64"
  ],
  "virtual_packages": {
    "cuda": "11.0"
  },
  "root_dir": "/opt/conda",
  "env_spec": null
}
